{
  "name": "pyside-iconify",
  "publisher": "lingchen",
  "displayName": "%pysideIconify.displayName%",
  "description": "%pysideIconify.description%",
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "pyside",
    "pyqt",
    "qt",
    "iconify",
    "icons",
    "python"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LingChen-tsjmdlc/pyside-iconify-vscode"
  },
  "bugs": {
    "url": "https://github.com/LingChen-tsjmdlc/pyside-iconify-vscode/issues"
  },
  "homepage": "https://github.com/LingChen-tsjmdlc/pyside-iconify-vscode#readme",
  "l10n": "./l10n",
  "icon": "resources/pyside-iconify.png",
  "packageManager": "pnpm@11.24.0",
  "activationEvents": [
    "onLanguage:python",
    "onCommand:pyside-iconify.searchIcons"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pyside-iconify.searchIcons",
        "title": "%pysideIconify.searchIcons.title%",
        "category": "PySide Iconify"
      }
    ],
    "configuration": {
      "title": "PySide Iconify",
      "properties": {
        "pyside-iconify.inlineIcons": {
          "type": "string",
          "default": "iconOnly",
          "enum": [
            "off",
            "iconBefore",
            "iconAfter",
            "iconOnly",
            "gutter"
          ],
          "enumDescriptions": [
            "%pysideIconify.inlineIcons.off%",
            "%pysideIconify.inlineIcons.iconBefore%",
            "%pysideIconify.inlineIcons.iconAfter%",
            "%pysideIconify.inlineIcons.iconOnly%",
            "%pysideIconify.inlineIcons.gutter%"
          ],
          "markdownDescription": "%pysideIconify.inlineIcons.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "pyside-iconify.searchIcons",
        "key": "ctrl+alt+shift+i",
        "mac": "cmd+alt+shift+i",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "editor.action.triggerSuggest",
        "key": "alt+enter",
        "mac": "alt+enter",
        "when": "editorHasCompletionItemProvider && editorTextFocus && !editorReadonly && editorLangId == python"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./ && node esbuild.mjs",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "verify:vsix": "node scripts/verify-vsix.mjs"
  },
  "dependencies": {
    "tree-sitter-python": "0.25.0",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.73.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.5.0",
    "jszip": "3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
